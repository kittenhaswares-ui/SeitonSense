<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.13.0.1</Version>
    <AssemblyVersion>0.13.0.1</AssemblyVersion>
    <FileVersion>0.13.0.1</FileVersion>
    <AssemblyName>SeitonSense.Plugin</AssemblyName>
    <RootNamespace>SeitonSense.Plugin</RootNamespace>
    <Authors>kittenhaswares-ui</Authors>
    <Description>PvP pressure, CC protection, isolation warning, resource auras, Seiton decisions, fail-closed assists, opt-in defensive/reactive utilities, a team focus sign, and target highlights.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SeitonSense.Core\SeitonSense.Core.csproj" />
    <Content Include="SeitonSense.Plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
