<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.18.0.1</Version>
    <AssemblyVersion>0.18.0.1</AssemblyVersion>
    <FileVersion>0.18.0.1</FileVersion>
    <AssemblyName>SeitonSense.Plugin</AssemblyName>
    <RootNamespace>SeitonSense.Plugin</RootNamespace>
    <Authors>kittenhaswares-ui</Authors>
    <Description>PvP pressure and high-focus warnings, optional low-MP Focus Target and DRK Shadowbringer macro helpers, held-key Sprint, CC protection, isolation, resource auras, fail-closed assists, defensive/reactive utilities, team focus, and target clarity.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SeitonSense.Core\SeitonSense.Core.csproj" />
    <Content Include="SeitonSense.Plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
