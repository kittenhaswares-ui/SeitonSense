<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.11.0.2</Version>
    <AssemblyVersion>0.11.0.2</AssemblyVersion>
    <FileVersion>0.11.0.2</FileVersion>
    <AssemblyName>SeitonSense.Plugin</AssemblyName>
    <RootNamespace>SeitonSense.Plugin</RootNamespace>
    <Authors>kittenhaswares-ui</Authors>
    <Description>PvP pressure, CC protection, an opt-in selected-target-aware hard-stop immunity brake, resource auras, Seiton decisions, warnings, fail-closed assists, job helpers, and target highlights.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SeitonSense.Core\SeitonSense.Core.csproj" />
    <Content Include="SeitonSense.Plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
